{
  "name": "@kungfu-trader/kungfu-app",
  "author": {
    "name": "Kungfu Trader",
    "email": "info@kungfu.link"
  },
  "version": "2.7.7-alpha.1",
  "description": "Kungfu App Framework",
  "license": "Apache-2.0",
  "repository": {
    "url": "https://github.com/kungfu-trader/kungfu.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "binary": {
    "module_name": "kungfu-app",
    "module_path": "dist/app",
    "remote_path": "{module_name}/v{major}/v{version}",
    "package_name": "{module_name}-v{version}-{platform}-{arch}-{configuration}.tar.gz",
    "host": "https://prebuilt.libkungfu.cc"
  },
  "types": "src/typings/index.d.ts",
  "main": "lib/index.js",
  "scripts": {
    "rebuild": "rm -rf ./node_modules && node --max_old_space_size=10240 lib/webpack/build.js",
    "build": "node --max_old_space_size=10240 lib/webpack/build.js",
    "build:one-thread": "yarn clean && yarn build --one-thread",
    "clean": "rimraf build dist node_modules/.cache",
    "install": "node -e \"require('@kungfu-trader/kungfu-core').prebuilt('install')\"",
    "package": "node -e \"require('@kungfu-trader/kungfu-core').prebuilt('package')\"",
    "lint": "eslint src",
    "format": "prettier -l -w --config ../core/.prettierrc.js ."
  },
  "dependencies": {
    "@electron/remote": "^2.0.0",
    "@kungfu-trader/kungfu-js-api": "^2.7.7-alpha.1",
    "@types/mark.js": "^8.11.8",
    "@visactor/vtable": "^1.2.0",
    "@vueuse/core": "^10.4.1",
    "ant-design-vue": "^3.2.20",
    "axios": "^0.21.1",
    "core-js": "^3.20.0",
    "echarts": "^5.3.3",
    "electron": "19.1.8",
    "electron-updater": "^5.3.0",
    "github-markdown-css": "^5.2.0",
    "iconv-lite": "^0.6.3",
    "jschardet": "^3.0.0",
    "mark.js": "^8.11.1",
    "markdown-it": "^13.0.1",
    "markdown-it-highlightjs": "^4.0.1",
    "markdown-it-task-checkbox-pro": "^1.0.0",
    "pinia": "^2.0.0",
    "sorted-btree": "^1.8.0",
    "sound-play": "^1.1.0",
    "vue": "^3.2.34"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.215",
    "@kungfu-trader/kungfu-toolchain": "^2.7.7-alpha.1",
    "@types/echarts": "^4.9.16",
    "@types/markdown-it": "^12.2.3",
    "webpack-bundle-analyzer": "^4.6.1"
  }
}
