{
  "name": "@kungfu-trader/examples-strategy-python",
  "author": {
    "name": "Kungfu Trader",
    "email": "info@kungfu.link"
  },
  "version": "2.7.7-alpha.1",
  "description": "KungFu Strategy 101 - Python Demo",
  "license": "Apache-2.0",
  "main": "package.json",
  "repository": {
    "url": "https://github.com/kungfu-trader/kungfu.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "binary": {
    "module_name": "examples-strategy-python",
    "module_path": "dist/KungfuStrategy101Python",
    "remote_path": "{module_name}/v{major}/v{version}",
    "package_name": "{module_name}-v{version}-{platform}-{arch}-{configuration}.tar.gz",
    "host": "https://prebuilt.libkungfu.cc"
  },
  "scripts": {
    "clean": "kfs extension clean",
    "build": "kfs extension build",
    "package": "kfs extension package",
    "install": "node -e \"require('@kungfu-trader/kungfu-core').prebuilt('install')\"",
    "format": "node ../../framework/core/.gyp/run-format-python.js src"
  },
  "kungfuBuild": {
    "python": {
      "dependencies": {}
    }
  },
  "kungfuConfig": {
    "key": "KungfuStrategy101Python",
    "assets": [
      {
        "name": "功夫示例策略",
        "src": "./src/python/KungfuStrategy101Python/__init__.py",
        "dest": "strategyDemo.py"
      }
    ]
  },
  "devDependencies": {
    "@kungfu-trader/kungfu-sdk": "^2.7.7-alpha.1"
  }
}
