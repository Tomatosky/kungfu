{
  "schema": "kungfu.gate-workflow-bindings/v1",
  "registry": "shifu.gates.json",
  "bindings": [
    {
      "id": "dev-source",
      "workflow": ".github/workflows/source-acceptance.yml",
      "job": "source-acceptance",
      "profiles": [
        "dev-pr"
      ],
      "gates": [
        "gate.catalog",
        "source.acceptance"
      ],
      "activation": "dev pull request",
      "requiredSnippets": [
        "- dev/v*/v*",
        "mode: source"
      ]
    },
    {
      "id": "dev-adr",
      "workflow": ".github/workflows/adr-release-gate.yml",
      "job": "adr-release",
      "profiles": [
        "dev-pr"
      ],
      "gates": [
        "governance.adr-delivery"
      ],
      "activation": "dev pull request",
      "requiredSnippets": [
        "./shifu adr:release:gate -- --github-event"
      ]
    },
    {
      "id": "dev-docs",
      "workflow": ".github/workflows/docs-check.yml",
      "job": "docs-check",
      "profiles": [
        "dev-pr"
      ],
      "gates": [
        "docs.contracts",
        "docs.prose"
      ],
      "activation": "dev pull request touching declared documentation paths",
      "requiredSnippets": [
        "./shifu docs:check:readonly",
        "./shifu docs:prose:required"
      ]
    },
    {
      "id": "all-pr-dco",
      "workflow": ".github/workflows/dco.yml",
      "job": "signoff",
      "profiles": [
        "dev-pr",
        "alpha-pr",
        "release-pr"
      ],
      "gates": [
        "governance.dco"
      ],
      "activation": "all pull requests",
      "requiredSnippets": [
        "Missing DCO sign-off",
        "Signed-off-by:"
      ]
    },
    {
      "id": "channel-buildchain-contract",
      "workflow": ".github/workflows/buildchain-validate.yml",
      "job": "validate,promotion-rehearsal",
      "profiles": [
        "dev-pr",
        "alpha-pr",
        "release-pr"
      ],
      "gates": [
        "governance.buildchain-config",
        "governance.promotion-rehearsal"
      ],
      "activation": "pull request or channel push",
      "requiredSnippets": [
        "require-lifecycle-stages: \"install,check,build,verify\"",
        "./shifu release:promotion:rehearse --"
      ]
    },
    {
      "id": "shifu-workspace",
      "workflow": ".github/workflows/shifu-ci.yml",
      "job": "check",
      "profiles": [
        "dev-pr",
        "alpha-pr",
        "release-pr"
      ],
      "gates": [
        "shifu.workspace"
      ],
      "activation": "channel pull request touching crates/**",
      "requiredSnippets": [
        "macos-14",
        "ubuntu-22.04",
        "windows-2022",
        "cargo test --workspace",
        "cargo build --workspace --release"
      ]
    },
    {
      "id": "dev-heavy-patrol",
      "workflow": ".github/workflows/dev-verify-patrol.yml",
      "job": "verify",
      "profiles": [
        "dev-patrol"
      ],
      "gates": [
        "gate.catalog",
        "product.distribution",
        "product.verify-full",
        "episode.smoke"
      ],
      "activation": "daily or manual on dev",
      "requiredSnippets": [
        "./shifu cache apply -- ./shifu verify --full",
        "kungfu-build-v4-linux-x64"
      ]
    },
    {
      "id": "dev-external-links",
      "workflow": ".github/workflows/docs-external-links.yml",
      "job": "external-links",
      "profiles": [
        "dev-patrol"
      ],
      "gates": [
        "docs.contracts",
        "docs.external-links"
      ],
      "activation": "daily or manual",
      "requiredSnippets": [
        "lycheeverse/lychee-action",
        "failIfEmpty: true"
      ]
    },
    {
      "id": "channel-heavy-build",
      "workflow": ".github/workflows/build.yml",
      "job": "build",
      "profiles": [
        "alpha-pr",
        "release-pr"
      ],
      "gates": [
        "gate.catalog",
        "governance.adr-delivery",
        "product.distribution",
        "product.verify-fuzz",
        "episode.smoke",
        "episode.release"
      ],
      "activation": "alpha or release pull request",
      "requiredSnippets": [
        "runner-preset: kungfu-v4-self-hosted",
        "./shifu cache apply -- ./shifu verify --fuzz",
        "./shifu cache apply -- ./shifu episode:qualify:release",
        "./shifu cache apply -- ./shifu adr:release:gate"
      ]
    },
    {
      "id": "channel-membranes",
      "workflow": ".github/workflows/embedding-membrane-spike.yml",
      "job": "native-membrane",
      "profiles": [
        "alpha-pr",
        "release-pr"
      ],
      "gates": [
        "embedding.membranes"
      ],
      "activation": "same-repo channel PR touching membrane paths",
      "requiredSnippets": [
        "Linux x64",
        "macOS ARM64",
        "Windows x64",
        "./shifu qualify:embedding-membranes"
      ]
    },
    {
      "id": "release-admission",
      "workflow": ".github/workflows/release-new-version.yml",
      "job": "promotion-contract,promote",
      "profiles": [
        "release-promotion"
      ],
      "gates": [
        "governance.buildchain-config",
        "governance.promotion-rehearsal",
        "release.artifact-admission"
      ],
      "activation": "merged alpha or release pull request",
      "requiredSnippets": [
        "required-status-check: build",
        "required-artifact-count: 3",
        "release-passport: true"
      ]
    }
  ]
}
