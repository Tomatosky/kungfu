{
  "name": "@kungfu-trader/kfx-ui-login-authing",
  "version": "3.1.0-alpha.1",
  "description": "The extension for Kungfu log in by Authing.",
  "author": {
    "name": "kungfu-trader",
    "email": "info@kungfu.link"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "Apache-2.0",
  "main": "package.json",
  "types": "./src/typings/index.ts",
  "binary": {
    "module_name": "kfx-ui-login-authing",
    "module_path": "dist/loginAuthing",
    "remote_path": "{module_name}/v{major}/v{version}",
    "package_name": "{module_name}-v{version}-{platform}-{arch}-{configuration}.tar.gz",
    "host": "https://prebuilt.libkungfu.cc"
  },
  "repository": {
    "url": "https://github.com/kungfu-trader/kungfu.git"
  },
  "scripts": {
    "build": "kfs extension build && node ./lib/webpack/build.js",
    "clean": "kfs extension clean",
    "install": "node -e \"require('@kungfu-trader/kungfu-core').prebuilt('install')\"",
    "format": "prettier -l -w --config ./.prettierrc.js .",
    "package": "kfs project package",
    "dev": "node ./lib/webpack/dev.js",
    "app": "yarn kfs craft dev",
    "cli": "yarn kfs craft cli"
  },
  "kungfuConfig": {
    "key": "loginAuthing",
    "name": "登录功夫",
    "ui_config": {
      "silent": true,
      "position": "sidebar_footer",
      "components": {
        "index": "uiComponent.js"
      }
    },
    "language": {
      "zh-CN": {
        "loginAuthing": "登录功夫",
        "login": "登录功夫",
        "phone": "手机号",
        "phoneWithCode": "手机验证码",
        "username": "用户",
        "email": "邮箱",
        "code": "验证码",
        "getCode": "获取验证码",
        "password": "密码",
        "confirm": "登录",
        "succeed": "登录成功",
        "failed": "登录失败",
        "logout": "退出登录",
        "transaction": "消费记录",
        "notLogin": "请先登录",
        "operationFailed": "操作失败, 请检查网络后重试",
        "expired": "登录认证已失效, 请重新登录",
        "phoneInvalid": "请输入正确的手机号码",
        "pleaseEnter": "请输入{value}",
        "notLoginTip": "还未登录",
        "concatUs": "联系我们",
        "applyForUse": "申请试用{name}",
        "networkError": "登录超时, 请检查网络环境后重试"
      },
      "en-US": {
        "loginAuthing": "Login Kungfu",
        "login": "Login Kungfu",
        "username": "User",
        "phone": "Phone",
        "phoneWithCode": "Phone Code",
        "email": "Email",
        "code": "Code",
        "getCode": "Get Code",
        "password": "Password",
        "confirm": "Login",
        "succeed": "Login Succeed",
        "failed": "Login Failed",
        "logout": "Logout",
        "transaction": "Transaction",
        "notLogin": "Please login first",
        "operationFailed": "Operation failed, please check network and try again",
        "expired": "Logon credential expired, please login again",
        "phoneInvalid": "Please enter correct phone number",
        "pleaseEnter": "Please enter {value}",
        "notLoginTip": "Not logged in",
        "concatUs": "Connect us",
        "applyForUse": "apply for trial {name}",
        "networkError": "Login timeout, please check the network environment and try again"
      }
    }
  },
  "dependencies": {
    "@kungfu-trader/kungfu-js-api": "^3.1.0-alpha.1",
    "authing-node-sdk": "^3.1.0"
  },
  "devDependencies": {
    "@kungfu-trader/kfx-broker-sim": "^3.1.0-alpha.1",
    "@kungfu-trader/kungfu-sdk": "^3.1.0-alpha.1",
    "@kungfu-trader/kungfu-toolchain": "^3.1.0-alpha.1"
  }
}
