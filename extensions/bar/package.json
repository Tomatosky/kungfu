{
  "name": "@kungfu-trader/kfx-operator-bar",
  "version": "3.0.8-alpha.2",
  "author": {
    "name": "Kungfu Trader",
    "email": "info@kungfu.link"
  },
  "description": "KungFu Operator for Bar Data",
  "license": "Apache-2.0",
  "main": "package.json",
  "repository": {
    "url": "https://github.com/kungfu-trader/kungfu.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "binary": {
    "module_name": "kfx-operator-bar",
    "module_path": "dist/bar",
    "remote_path": "{module_name}/v{major}/v{version}",
    "package_name": "{module_name}-v{version}-{platform}-{arch}-{configuration}.tar.gz",
    "host": "https://prebuilt.libkungfu.cc"
  },
  "scripts": {
    "clean": "kfs extension clean",
    "build": "kfs extension build",
    "package": "kfs extension package",
    "install": "node -e \"require('@kungfu-trader/kungfu-core').prebuilt('install')\"",
    "format": "node ../../framework/core/.gyp/run-format-cpp.js src"
  },
  "dependencies": {
    "@kungfu-trader/kungfu-core": "^3.0.8-alpha.2"
  },
  "devDependencies": {
    "@kungfu-trader/kungfu-sdk": "^3.0.8-alpha.2"
  },
  "kungfuConfig": {
    "key": "bar",
    "name": "Bar",
    "language": {
      "zh-CN": {
        "id": "Bar ID",
        "id_tip": "请输入 Bar ID",
        "source": "数据源",
        "source_tip": "请选择数据源",
        "instruments": "标的",
        "instruments_tip": "选择需要计算的标的",
        "period": "周期",
        "period_tip": "请输入计算周期, 秒为单位"
      },
      "en-US": {
        "id": "Bar ID",
        "id_tip": "Please enter Bar ID",
        "source": "Data Source",
        "source_tip": "Please select a data source",
        "instruments": "instruments",
        "instruments_tip": "Please select instruments",
        "period": "Period",
        "period_tip": "Please enter period number, seconds as unit"
      }
    },
    "config": {
      "operator": {
        "settings": [
          {
            "key": "id",
            "name": "bar.id",
            "type": "str",
            "tip": "bar.id_tip",
            "required": true,
            "primary": true
          },
          {
            "key": "source",
            "name": "bar.source",
            "type": "md",
            "tip": "bar.source_tip",
            "required": true
          },
          {
            "key": "instruments",
            "name": "bar.instruments",
            "type": "instruments",
            "tip": "bar.instruments_tip",
            "required": true
          },
          {
            "key": "period",
            "name": "bar.period",
            "type": "int",
            "tip": "bar.period_tip",
            "min": 1,
            "default": 1,
            "required": true
          }
        ]
      }
    }
  }
}
