{
  "name": "@kungfu-trader/kfx-ui-wallet",
  "version": "3.0.8-alpha.2",
  "description": "The wallet extension for Kungfu.",
  "author": {
    "name": "kungfu-trader",
    "email": "info@kungfu.link"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "Apache-2.0",
  "main": "package.json",
  "types": "./src/typings/index.ts",
  "binary": {
    "module_name": "kfx-ui-wallet",
    "module_path": "dist/awsWallet",
    "remote_path": "{module_name}/v{major}/v{version}",
    "package_name": "{module_name}-v{version}-{platform}-{arch}-{configuration}.tar.gz",
    "host": "https://prebuilt.libkungfu.cc"
  },
  "repository": {
    "url": "https://github.com/kungfu-trader/kungfu.git"
  },
  "scripts": {
    "build": "kfs extension build && node ./lib/webpack/build.js",
    "clean": "kfs extension clean",
    "install": "node -e \"require('@kungfu-trader/kungfu-core').prebuilt('install')\"",
    "format": "prettier -l -w --config ./.prettierrc.js .",
    "package": "kfs project package",
    "dev": "node ./lib/webpack/dev.js",
    "app": "yarn kfs craft dev",
    "cli": "yarn kfs craft cli"
  },
  "kungfuConfig": {
    "key": "awsWallet",
    "name": "钱包",
    "ui_config": {
      "silent": true,
      "position": "footer",
      "components": {
        "index": "uiComponent.js"
      }
    },
    "language": {
      "zh-CN": {
        "awsWallet": "钱包",
        "unit": "气",
        "balance": "余额",
        "costRecords": "消费记录",
        "recharge": "充值",
        "cost": "消费",
        "usedChart": "用量详情",
        "transRecords": "充值消费记录",
        "transTime": "时间",
        "transType": "类型",
        "transNote": "备注",
        "transAmount": "操作数量",
        "amountTips": "此为预估量，回测完成后，将会根据实际用量更新账单",
        "getError": "获取数据失败，请稍后重试"
      },
      "en-US": {
        "awsWallet": "Wallet",
        "unit": "Chi",
        "balance": "Balance",
        "costRecords": "Cost records",
        "recharge": "Recharge",
        "cost": "Cost",
        "usedChart": "Used chart",
        "transRecords": "Recharge/Cost records",
        "transTime": "Time",
        "transType": "Type",
        "transNote": "Note",
        "transAmount": "Amount",
        "amountTips": "This is an estimation, after the backtest is completed, the bill will be updated according to the actual usage",
        "getError": "Get data failed, please try again later"
      }
    }
  },
  "dependencies": {
    "@kungfu-trader/kfx-ui-login-authing": "^3.0.8-alpha.2",
    "@kungfu-trader/kungfu-js-api": "^3.0.8-alpha.2",
    "authing-node-sdk": "^3.1.0",
    "axios": "^1.6.2",
    "echarts": "^5.4.3"
  },
  "devDependencies": {
    "@kungfu-trader/kungfu-sdk": "^3.0.8-alpha.2",
    "@kungfu-trader/kungfu-toolchain": "^3.0.8-alpha.2",
    "@types/js-yaml": "^4.0.5"
  }
}
