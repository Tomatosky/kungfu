{
  "name": "@kungfu-trader/kfx-ui-extension-manager",
  "version": "3.0.8-alpha.2",
  "description": "The extension for Kungfu extension manager.",
  "author": {
    "name": "kungfu-trader",
    "email": "info@kungfu.link"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "Apache-2.0",
  "main": "package.json",
  "types": "./src/typings/index.ts",
  "binary": {
    "module_name": "kfx-ui-extension-manager",
    "module_path": "dist/extensionManager",
    "remote_path": "{module_name}/v{major}/v{version}",
    "package_name": "{module_name}-v{version}-{platform}-{arch}-{configuration}.tar.gz",
    "host": "https://prebuilt.libkungfu.cc"
  },
  "repository": {
    "url": "https://github.com/kungfu-trader/kungfu.git"
  },
  "scripts": {
    "build": "kfs extension build && node ./lib/webpack/build.js",
    "clean": "kfs extension clean",
    "install": "node -e \"require('@kungfu-trader/kungfu-core').prebuilt('install')\"",
    "format": "prettier -l -w --config ./.prettierrc.js .",
    "package": "kfs project package",
    "dev": "node ./lib/webpack/dev.js",
    "app": "yarn kfs craft dev",
    "cli": "yarn kfs craft cli"
  },
  "kungfuConfig": {
    "key": "extensionManager",
    "name": "插件",
    "ui_config": {
      "silent": true,
      "position": "sidebar",
      "components": {
        "entry": "entry.js",
        "page": "page.js"
      }
    },
    "language": {
      "zh-CN": {
        "extensionManager": "插件",
        "extensionStore": "插件库",
        "installed": "已安装",
        "uninstalled": "未安装",
        "td": "交易账户",
        "md": "行情柜台",
        "strategy": "交易任务",
        "operator": "算子",
        "system": "系统服务",
        "indexer": "索引器",
        "matcher": "撮合器",
        "ui": "交互功能",
        "cli": "命令行",
        "needLogin": "需登录",
        "noAccess": "暂无权限",
        "extUse": "使用",
        "extProfile": "插件详情",
        "extVersion": "插件版本",
        "compliantSysVersion": "适用系统版本",
        "extDesc": "简介",
        "install": "安装",
        "uninstall": "卸载",
        "nothing": "暂无",
        "noInformation": "暂无信息",
        "loginFirst": "请先登录",
        "applyForUse": "联系我们，申请试用{extName}",
        "guide": {
          "login": "登录",
          "loginDesc": "高精策略回测插件需要登录后才能使用，请输入手机号、验证码，登录功夫。",
          "toGetAccess": "获取权限",
          "toGetAccessDesc": "点击此处联系我们，申请试用{extName}。",
          "toSyncData": "同步数据",
          "toSyncDataDesc": "成功开通权限后，在账户信息的气泡中点击同步数据，即可获取最新权限信息，使用高精策略回测。"
        }
      },
      "en-US": {
        "extensionManager": "Extensions",
        "extensionStore": "Extension Store",
        "installed": "Installed",
        "uninstalled": "Uninstalled",
        "td": "Td",
        "md": "Md",
        "strategy": "Strategy",
        "operator": "Operator",
        "system": "System",
        "indexer": "Indexer",
        "matcher": "Matcher",
        "ui": "UI",
        "cli": "Cli",
        "needLogin": "Need Login",
        "noAccess": "Has no access",
        "extUse": "Use",
        "extProfile": "Profile",
        "extVersion": "Extension Version",
        "compliantSysVersion": "Compliant System Version",
        "extDesc": "Extension Desc",
        "install": "Install",
        "uninstall": "Uninstall",
        "nothing": "Nothing",
        "noInformation": "No Information",
        "loginFirst": "Login first",
        "applyForUse": "Connect us, apply for trial {extName}",
        "guide": {
          "login": "Login",
          "loginDesc": "High precision strategy backtesting needs to be logged in to use, please enter the phone number and verification code to log in",
          "toGetAccess": "Get Access",
          "toGetAccessDesc": "Click here to contact us, apply for trial {extName}",
          "toSyncData": "Sync Data",
          "toSyncDataDesc": "After successful activation of permissions, click on the bubble in the account information to synchronize data, and you can get the latest permission information"
        }
      }
    }
  },
  "dependencies": {
    "@kungfu-trader/kfx-ui-login-authing": "^3.0.8-alpha.2",
    "@kungfu-trader/kfx-ui-novice-guide": "^3.0.8-alpha.2",
    "@kungfu-trader/kungfu-app": "^3.0.8-alpha.2",
    "@kungfu-trader/kungfu-cli": "^3.0.8-alpha.2",
    "@kungfu-trader/kungfu-core": "^3.0.8-alpha.2",
    "@kungfu-trader/kungfu-js-api": "^3.0.8-alpha.2",
    "pinia": "~2.0.0"
  },
  "devDependencies": {
    "@kungfu-trader/kfx-broker-sim": "^3.0.8-alpha.2",
    "@kungfu-trader/kungfu-sdk": "^3.0.8-alpha.2",
    "@kungfu-trader/kungfu-toolchain": "^3.0.8-alpha.2"
  }
}
